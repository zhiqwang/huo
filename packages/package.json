{
  "name": "huo-art-js",
  "version": "0.1.0",
  "description": "CT Algebraic Reconstruction Technique (ART) implemented with jax-js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:docs": "tsc --outDir dist --sourceMap false --declaration false --declarationMap false",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "tsc && npx serve ."
  },
  "dependencies": {
    "@jax-js/jax": "^0.1.27"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
