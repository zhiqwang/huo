{
  "name": "huo-jax-js",
  "version": "0.1.0",
  "description": "Differentiable fan-beam projection and loss-based CT reconstruction with jax-js",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:docs": "node tools/build.mjs --docs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && npx serve dist"
  },
  "dependencies": {
    "@jax-js/jax": "0.1.27",
    "@jax-js/optax": "0.1.3"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "typescript": "^6.0.2"
  }
}
